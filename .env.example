# AirSathi Configuration
# Primary Open-Meteo Air Quality & Geocoding APIs require no API key for eligible non-commercial civic usage.

# Google Gemini API key for Generative AI Civic Intelligence Layer
# If left empty, AirSathi seamlessly runs its built-in deterministic Civic Intelligence Engine.
GEMINI_API_KEY=""

# Firebase Client Credentials for Google OAuth Authentication
# (Client-side identity verification only. Zero database, zero user profile storage)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Optional Secondary Provider: CPCB / Data.gov.in National AQI Monitoring Stations
# Real-time monitoring station dataset: https://www.data.gov.in/catalog/real-time-air-quality-index
# If omitted, CPCB is cleanly disclosed as requiring configuration, and Open-Meteo CAMS serves as primary.
DATA_GOV_IN_API_KEY=""

# Optional Secondary Provider: OpenAQ API v3 Global Research Network
# Documentation: https://api.openaq.org/v3
# Optional integration; Open-Meteo CAMS serves as primary active source.
OPENAQ_API_KEY=""
